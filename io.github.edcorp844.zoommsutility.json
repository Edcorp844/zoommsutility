{
    "id" : "io.github.edcorp844.zoommsutility",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "zoom_ms_utility",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=all"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "env" : {
            "PATH" : "/usr/lib/sdk/rust-stable/bin:/usr/bin:/bin",
            "RUST_BACKTRACE" : "1",
            "RUST_LOG" : "zoom_ms_utility=debug"
        },
        "build-args" : [
            "--share=network"
        ]
    },
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "libpanel",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.gnome.org/GNOME/libpanel.git",
                    "tag" : "1.8.0"
                }
            ]
        },
        {
            "name" : "zoom_ms_utility",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/Edcorp844/Zoom-MS-Utility.git",
                    "branch" : "main"
                }
            ]
        }
    ]
}